# Copy this file to .env (git-ignored) and fill in ONE of the two options.
# Never commit .env or paste keys into chat, code or tickets.

# Option A - Amazon Bedrock (Punctualiti's AWS account)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=          # only for temporary credentials

# Option B - Claude API
# ANTHROPIC_API_KEY=

# Optional
# PUNCTUALITI_AI_PROVIDER=bedrock     # force a provider if both are set
# PUNCTUALITI_AI_MODEL=claude-opus-5-5                          # Claude API model
# PUNCTUALITI_BEDROCK_MODEL=global.anthropic.claude-opus-4-6-v1   # Bedrock inference profile
